# ---------------------------------------------------------------------------
# Ayah & Hadith — environment configuration
# ---------------------------------------------------------------------------
# Only URL overrides are needed for the default providers, because the default
# Quran (alquran.cloud) and Hadith (fawazahmed0/hadith-api) sources are free and
# require NO API key. Keys below are optional and only used if you swap in a
# provider that requires authentication. NEVER put secret keys in a variable
# prefixed with NEXT_PUBLIC_ — those are exposed to the browser.
# ---------------------------------------------------------------------------

# Quran data provider (default: alquran.cloud, keyless)
NEXT_PUBLIC_QURAN_API_URL=https://api.alquran.cloud/v1

# Hadith data provider (default: fawazahmed0 hadith-api on jsDelivr, keyless)
NEXT_PUBLIC_HADITH_API_URL=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1

# Optional server-side secrets (used only by providers that require them,
# proxied through /api routes so they are never shipped to the client).
QURAN_API_KEY=
HADITH_API_KEY=

# --- AI background generation (proxied via /api/ai-background) -------------
# Default provider is Pollinations (keyless): https://image.pollinations.ai/prompt
# Point this at any text-to-image provider and add a key if required.
AI_IMAGE_API_URL=https://image.pollinations.ai/prompt
AI_IMAGE_API_KEY=
